# Copie este arquivo para .env e preencha os valores reais
#
# Desenvolvimento local (docker compose up -d postgres):
DATABASE_URL=postgresql://ester:ester123@localhost:5432/studio_ester
#
# Railway (produção) — serviço do BACKEND (use "Add Reference" no painel):
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   NODE_ENV=production
#
# NÃO use postgres.railway.internal no PC local (só funciona dentro do Railway).
# NÃO use DATABASE_PRIVATE_URL.
# NÃO monte DATABASE_URL com ${{RAILWAY_PRIVATE_DOMAIN}} no backend.

JWT_ACCESS_SECRET=troque_por_segredo_aleatorio_longo_access
JWT_REFRESH_SECRET=troque_por_segredo_aleatorio_longo_refresh

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=3001
NODE_ENV=development

# URL(s) do frontend (CORS). Várias URLs: separar por vírgula.
FRONTEND_URL=http://localhost:3000,https://app-studio-ester-rodrigues.vercel.app

# E-mail (aviso de nova reserva) — configurar SMTP real em produção
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=senha_smtp

SALON_NAME="Studio Ana Ester"
SALON_EMAIL=contato@studioester.com.br

# Seed — conta inicial do dono (usada apenas na primeira execução de npm run seed)
OWNER_NAME=Ester
OWNER_EMAIL=ester@studioester.com.br
OWNER_PASSWORD=Trocar@123

# Web Push (PWA) — gere o par de chaves com: npm run vapid:generate
# Sem as duas chaves, GET /api/push/vapid-public-key responde 503 e o app
# não consegue ativar as notificações. No Railway, defina as duas no serviço
# do backend (Variables) e faça redeploy.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@studioester.com.br

# WhatsApp Cloud API (Meta) — template precisa estar APROVADO no Business Manager
# Variáveis do template (ordem): cliente, serviço, data, hora
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=nova_reserva
WHATSAPP_TEMPLATE_LANG=pt_BR

# Recuperação de senha por código no celular (canal principal: WhatsApp)
# Template com UMA variável no corpo: o código de 6 dígitos.
# Se o template for da categoria "Autenticação" (com botão copiar código),
# use WHATSAPP_OTP_TEMPLATE_COPY_BUTTON=true.
WHATSAPP_OTP_TEMPLATE_NAME=codigo_recuperacao
WHATSAPP_OTP_TEMPLATE_LANG=pt_BR
WHATSAPP_OTP_TEMPLATE_COPY_BUTTON=false

# Fallback por SMS (Twilio) — usado se o envio por WhatsApp falhar
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550000000
