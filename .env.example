# Copie este arquivo para .env e preencha os valores reais
DATABASE_URL=postgresql://user:password@localhost:5432/studio_ester

# Railway (produção) — serviço do BACKEND (use "Add Reference" no painel):
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   NODE_ENV=production
#
# "Postgres" = nome exato do serviço de banco no Railway (case-sensitive).
# NÃO use DATABASE_PRIVATE_URL (não existe no Postgres gerenciado).
# NÃO monte DATABASE_URL com ${{RAILWAY_PRIVATE_DOMAIN}} no backend.

JWT_ACCESS_SECRET=troque_por_segredo_aleatorio_longo_access
JWT_REFRESH_SECRET=troque_por_segredo_aleatorio_longo_refresh

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=3001
NODE_ENV=development

# URL(s) do frontend (CORS). Várias URLs: separar por vírgula.
FRONTEND_URL=https://app-studio-ester-rodrigues.vercel.app

# E-mail (recuperação de senha) — configurar SMTP real em produção
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=senha_smtp

SALON_NAME="Studio Ester"
SALON_EMAIL=contato@studioester.com.br

# Seed — conta inicial do dono (usada apenas na primeira execução de npm run seed)
OWNER_NAME=Ester
OWNER_EMAIL=ester@studioester.com.br
OWNER_PASSWORD=Trocar@123
